{
  "name": "zai-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "seed:admin": "tsx --env-file=.env src/db/seed-admin.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:admin:prod": "node dist/db/seed-admin.js"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
